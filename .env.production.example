# ============================================================
# PRODUCTION .env template — JANGAN PAKAI VALUE DEFAULT DI BAWAH!
# ============================================================
# Generate semua secret baru sebelum deploy. Backend akan refuse-to-boot
# kalau JWT_SECRET / JWT_REFRESH_SECRET / SEED_ADMIN_KEY masih default
# "change-me-*" atau panjangnya < 32 char (lihat src/config/configuration.ts).
#
# Cara generate 256-bit hex (paste ke terminal):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# atau:
#   openssl rand -hex 48
# ============================================================

# App
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database — ganti credential biar tidak sama dengan dev
DATABASE_URL=postgresql://quranuser:GANTI_PASSWORD_KUAT_DI_SINI@postgres:5432/quran_db?schema=public

# Redis — biarkan default kalau pakai docker-compose.yml apa adanya
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — WAJIB generate baru, min 32 char
JWT_SECRET=__GENERATE_DENGAN_openssl_rand_hex_48__
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__GENERATE_DENGAN_openssl_rand_hex_48_LAGI_HARUS_BEDA__
JWT_REFRESH_EXPIRES_IN=7d

# External API
EQURAN_BASE_URL=https://equran.id/api/v2
EQURAN_REQUEST_DELAY_MS=250
QURAN_PAGE_BASE_URL=https://api.quran.com/api/v4
QURAN_PAGE_ENABLED=true

# Seed admin — WAJIB generate baru, ini "master key" untuk seed/snapshot/api-keys
SEED_ADMIN_KEY=__GENERATE_DENGAN_openssl_rand_hex_32__

# CORS — set ke domain frontend Anda
# Contoh: https://quran.domain.com,https://www.quran.domain.com
CORS_ORIGIN=https://yourdomain.com

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Audio cache + snapshot persistent volume
AUDIO_CACHE_DIR=/app/audio-cache
SNAPSHOT_DIR=/app/snapshots

# Firebase Cloud Messaging — kosongkan kalau belum siap push notification
# Generate service account JSON di Firebase Console → Project Settings →
# Service accounts → Generate new private key. Mount file-nya ke /app/secrets/firebase.json
FCM_SERVICE_ACCOUNT_PATH=

# Email admin yang akan otomatis di-promote ke role=admin saat first boot
# Daftar lewat /register dengan email ini → restart container → langsung jadi admin
ADMIN_BOOTSTRAP_EMAIL=
