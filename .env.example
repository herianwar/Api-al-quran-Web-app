# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://quranuser:quranpass@localhost:5432/quran_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-super-secret-key-minimum-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# External API
EQURAN_BASE_URL=https://equran.id/api/v2
EQURAN_REQUEST_DELAY_MS=250

# Page/Juz source (equran.id v2 has no page metadata, so juz & mushaf page
# numbers are fetched from Quran.com API v4 during ayat seeding). Set
# QURAN_PAGE_ENABLED=false to skip and leave halaman/juz columns null.
QURAN_PAGE_BASE_URL=https://api.quran.com/api/v4
QURAN_PAGE_ENABLED=true

# Seed
SEED_ADMIN_KEY=change-me-seed-admin-key

# Master key for encrypting AppSetting secrets (AI API keys, etc.).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=change-me-base64-32-bytes-min

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=*

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Audio cache (self-hosted MP3 proxy): directory where downloaded Quran
# audio is stored. Persist this across container restarts via a Docker
# volume so warm-up only needs to run once.
AUDIO_CACHE_DIR=/app/audio-cache

# Snapshot dir: where pg_dump exports of the Quran content tables land.
# Mount as a Docker volume so snapshots survive redeploys.
SNAPSHOT_DIR=/app/snapshots

# Firebase Cloud Messaging service account JSON path (for push
# notifications). Generate at Firebase Console → Project Settings →
# Service accounts → Generate new private key. Leave empty to disable.
FCM_SERVICE_ACCOUNT_PATH=

# At boot, the user with this email gets role=admin automatically.
# Use this to bootstrap the FIRST admin without manually editing the DB.
ADMIN_BOOTSTRAP_EMAIL=
